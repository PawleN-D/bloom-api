generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model assignments {
  id        String   @id
  userId    String
  clientId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  clients   clients  @relation(fields: [clientId], references: [id])
  users     users    @relation(fields: [userId], references: [id])

  @@unique([userId, clientId])
  @@index([clientId])
  @@index([userId])
}

model clients {
  id                       String        @id
  firstName                String
  lastName                 String
  dateOfBirth              DateTime?
  address                  String?
  phone                    String?
  email                    String?
  conditions               String?
  allergies                String?
  carePlan                 String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  isActive                 Boolean       @default(true)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime
  assignments              assignments[]
  files                    files[]
  notes                    notes[]
  tasks                    tasks[]

  @@index([lastName])
}

model files {
  id           String   @id
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  clientId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  clients      clients  @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

model notes {
  id        String       @id
  content   String
  category  NoteCategory @default(GENERAL)
  clientId  String
  authorId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime
  users     users        @relation(fields: [authorId], references: [id])
  clients   clients      @relation(fields: [clientId], references: [id])

  @@index([authorId])
  @@index([clientId])
  @@index([createdAt])
}

model task_completions {
  id          String   @id
  taskId      String
  completedBy String
  completedAt DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  users       users    @relation(fields: [completedBy], references: [id])
  tasks       tasks    @relation(fields: [taskId], references: [id])

  @@index([completedBy])
  @@index([taskId])
}

model tasks {
  id               String             @id
  title            String
  description      String?
  category         TaskCategory       @default(GENERAL)
  priority         TaskPriority       @default(NORMAL)
  clientId         String
  isRecurring      Boolean            @default(false)
  dueDate          DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  task_completions task_completions[]
  clients          clients            @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([dueDate])
}

model users {
  id               String             @id
  email            String             @unique
  password         String
  firstName        String
  lastName         String
  role             UserRole           @default(WORKER)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  assignments      assignments[]
  notes            notes[]
  task_completions task_completions[]

  @@index([email])
}

enum NoteCategory {
  PROGRESS
  OBSERVATION
  INCIDENT
  COMMUNICATION
  GENERAL
}

enum TaskCategory {
  PERSONAL_CARE
  MEDICATION
  MEAL_PREP
  MOBILITY
  HOUSEKEEPING
  COMPANIONSHIP
  HEALTH_MONITORING
  GENERAL
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum UserRole {
  WORKER
  ADMIN
}
