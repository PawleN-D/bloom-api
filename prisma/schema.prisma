generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS (Existing + New)
// ============================================================================

enum NoteCategory {
  PROGRESS
  OBSERVATION
  INCIDENT
  COMMUNICATION
  GENERAL
}

enum TaskCategory {
  PERSONAL_CARE
  MEDICATION
  MEAL_PREP
  MOBILITY
  HOUSEKEEPING
  COMPANIONSHIP
  HEALTH_MONITORING
  GENERAL
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskCompletionStatus {
  COMPLETE
  INCOMPLETE
  REFUSED
}

enum UserRole {
  WORKER
  ADMIN
  MANAGER
  ORG_OWNER
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  PAST_DUE
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FeatureCategory {
  CORE
  COMPLIANCE
  AI
  ADVANCED
  INTEGRATIONS
  ENTERPRISE
}

enum AuditAccessStatus {
  SUCCESS
  FAILED
}

// ============================================================================
// NEW MODELS (Multi-Tenancy)
// ============================================================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  subdomain   String   @unique
  
  logo         String?
  primaryColor String?  @default("#0F766E")
  
  plan         SubscriptionPlan @default(STARTER)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  billingEmail String?
  maxUsers     Int      @default(10)
  maxClients   Int      @default(50)
  
  active      Boolean  @default(true)
  suspended   Boolean  @default(false)
  trialEndsAt DateTime?
  
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  clients     Client[]
  tasks       Task[]
  notes       Note[]
  organizationFeatures OrganizationFeature[]
  auditAccessLogs AuditAccessLog[]
  securityLogs   SecurityLog[]
  subscription   Subscription?
  invoices       Invoice[]
  discountRedemptions DiscountRedemption[]
  supportTickets SupportTicket[]
  
  @@index([slug])
  @@index([subdomain])
  @@index([active])
  @@index([subscriptionStatus])
}

model Feature {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  category    FeatureCategory
  
  availableInPlans SubscriptionPlan[]
  betaFeature      Boolean  @default(false)
  comingSoon       Boolean  @default(false)
  defaultEnabled   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  organizationFeatures OrganizationFeature[]
  
  @@index([key])
  @@index([category])
}

model OrganizationFeature {
  id             String   @id @default(cuid())
  organizationId String
  featureId      String
  enabled        Boolean
  config         Json?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature        Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)
  
  @@unique([organizationId, featureId])
  @@index([organizationId])
  @@index([featureId])
}

// ============================================================================
// EXISTING MODELS (Updated with organizationId)
// ============================================================================

model User {
  id             String   @id
  email          String   @unique
  passwordHash   String?
  pinHash        String?
  invitationToken String? @unique
  tokenExpires   DateTime?
  status         UserStatus @default(PENDING)
  dbsExpiresAt   DateTime?
  trainingExpiresAt DateTime?
  firstName      String
  lastName       String
  role           UserRole @default(WORKER)
  
  // Multi-tenancy field
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  assignments      Assignment[]
  notes            Note[]
  taskCompletions  TaskCompletion[]
  securityLogs     SecurityLog[]
  auditAccessLogsManaged AuditAccessLog[] @relation("AuditAccessLogManager")
  supportTicketsCreated SupportTicket[] @relation("SupportTicketCreator")
  supportTicketsAssigned SupportTicket[] @relation("SupportTicketAssignee")
  supportNotes SupportNote[]
  
  @@index([email])
  @@index([organizationId])
  @@index([dbsExpiresAt])
  @@index([trainingExpiresAt])
  @@map("users")
}

model Client {
  id                       String    @id
  
  // Multi-tenancy field
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  firstName                String
  lastName                 String
  dateOfBirth              DateTime?
  address                  String?
  phone                    String?
  email                    String?
  conditions               String?
  allergies                String?
  carePlan                 String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime
  
  assignments              Assignment[]
  files                    File[]
  notes                    Note[]
  tasks                    Task[]
  auditAccessLogs          AuditAccessLog[]
  
  @@index([lastName])
  @@index([organizationId])
  @@map("clients")
}

model Assignment {
  id        String   @id
  userId    String
  clientId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  
  client    Client   @relation(fields: [clientId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  
  @@unique([userId, clientId])
  @@index([clientId])
  @@index([userId])
  @@map("assignments")
}

model Task {
  id               String       @id
  
  // Multi-tenancy field
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title            String
  description      String?
  category         TaskCategory @default(GENERAL)
  priority         TaskPriority @default(NORMAL)
  clientId         String
  isRecurring      Boolean      @default(false)
  dueDate          DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime
  
  taskCompletions  TaskCompletion[]
  client           Client       @relation(fields: [clientId], references: [id])
  
  @@index([clientId])
  @@index([dueDate])
  @@index([organizationId])
  @@map("tasks")
}

model TaskCompletion {
  id                   String               @id
  taskId               String
  completedBy          String
  completedAt          DateTime             @default(now())
  status               TaskCompletionStatus @default(COMPLETE)
  refusalReason        String?
  notes                String?
  version              Int                  @default(1)
  parentLogId          String?
  editReason           String?
  metadata             Json?
  signatureSvg         String?
  initials             String?
  deviceInfo           String?
  ipAddress            String?
  criticalAlertFlagged Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  
  user        User     @relation(fields: [completedBy], references: [id])
  task        Task     @relation(fields: [taskId], references: [id])
  parentLog   TaskCompletion? @relation("TaskCompletionVersionHistory", fields: [parentLogId], references: [id])
  versions    TaskCompletion[] @relation("TaskCompletionVersionHistory")
  
  @@index([completedBy])
  @@index([completedAt])
  @@index([completedBy, completedAt])
  @@index([taskId])
  @@index([parentLogId])
  @@map("task_completions")
}

model AuditAccessLog {
  id             String            @id @default(cuid())
  organizationId String
  residentId     String
  managerId      String
  status         AuditAccessStatus
  createdAt      DateTime          @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resident       Client            @relation(fields: [residentId], references: [id], onDelete: Restrict)
  manager        User              @relation("AuditAccessLogManager", fields: [managerId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([residentId])
  @@index([managerId])
  @@index([createdAt])
  @@map("audit_access_logs")
}

model SecurityLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String
  action         String
  metadata       Json?
  statusCode     Int?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("security_logs")
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String             @unique
  plan               SubscriptionPlan
  status             SubscriptionStatus @default(ACTIVE)
  priceCents         Int
  currency           String             @default("USD")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelRequestedAt  DateTime?
  canceledAt         DateTime?
  gracePeriodEndsAt  DateTime?
  pausedAt           DateTime?
  resumedAt          DateTime?
  discountId         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  discount           Discount?          @relation(fields: [discountId], references: [id])
  invoices           Invoice[]
  redemptions        DiscountRedemption[]

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([discountId])
  @@map("subscriptions")
}

model Discount {
  id              String        @id @default(cuid())
  code            String        @unique
  type            DiscountType
  value           Int
  active          Boolean       @default(true)
  maxRedemptions  Int?
  redeemedCount   Int           @default(0)
  validFrom       DateTime?
  validTo         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  subscriptions   Subscription[]
  redemptions     DiscountRedemption[]

  @@index([active])
  @@index([validFrom])
  @@index([validTo])
  @@map("discounts")
}

model DiscountRedemption {
  id              String       @id @default(cuid())
  discountId      String
  subscriptionId  String
  organizationId  String
  redeemedAt      DateTime     @default(now())

  discount        Discount     @relation(fields: [discountId], references: [id], onDelete: Cascade)
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([discountId, subscriptionId])
  @@index([organizationId])
  @@index([redeemedAt])
  @@map("discount_redemptions")
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  subscriptionId  String
  status          InvoiceStatus @default(OPEN)
  subtotalCents   Int
  discountCents   Int           @default(0)
  totalCents      Int
  currency        String        @default("USD")
  issuedAt        DateTime      @default(now())
  dueAt           DateTime
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  lineItems       InvoiceLineItem[]

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([status])
  @@index([issuedAt])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  amountCents Int
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model SupportTicket {
  id             String               @id @default(cuid())
  organizationId String?
  subject        String
  description    String
  status         SupportTicketStatus  @default(OPEN)
  priority       SupportTicketPriority @default(MEDIUM)
  createdById    String?
  assignedToId   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?                @relation("SupportTicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo     User?                @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes          SupportNote[]

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportNote {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String?
  body       String
  internal   Boolean  @default(true)
  createdAt  DateTime @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([authorId])
  @@index([createdAt])
  @@map("support_notes")
}

model Note {
  id                String       @id
  
  // Multi-tenancy field
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  content           String
  category          NoteCategory @default(GENERAL)
  clientId          String
  authorId          String
  parentLogId       String?
  version           Int          @default(1)
  isLatest          Boolean      @default(true)
  editReason        String?
  isSignificant     Boolean      @default(false)
  originalCreatedAt DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime
  
  user              User         @relation(fields: [authorId], references: [id])
  client            Client       @relation(fields: [clientId], references: [id])
  parent            Note?        @relation("NoteVersionHistory", fields: [parentLogId], references: [id])
  versions          Note[]       @relation("NoteVersionHistory")
  
  @@index([authorId])
  @@index([clientId])
  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([clientId, createdAt])
  @@index([parentLogId])
  @@index([isLatest])
  @@index([isSignificant])
  @@index([organizationId])
  @@map("notes")
}

model File {
  id           String   @id
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  clientId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  
  client       Client   @relation(fields: [clientId], references: [id])
  
  @@index([clientId])
  @@map("files")
}
