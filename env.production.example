# Production Environment Variables
# Copy this to Railway environment variables

# Server
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Database (Railway will provide this)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT (Generate a strong secret!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
SESSION_UNLOCK_EXPIRES_IN=5m

# CORS
FRONTEND_URL=https://your-frontend-url.vercel.app
FRONTEND_URLS=https://your-frontend-url.vercel.app,https://hq.bloom.com
BASE_DOMAIN=bloom.com

# Cloudflare R2 (optional for now)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=onboarding@bloom.care

# Jobs
REDIS_URL=redis://localhost:6379
