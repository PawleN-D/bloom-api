# Render Environment Variables
# Copy these into Render dashboard → Environment

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Get this from PostgreSQL instance page → Internal Database URL
DATABASE_URL=postgres://bloom_user:PASSWORD@INTERNAL_HOST:5432/bloom_db

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_A_STRONG_SECRET_HERE

JWT_EXPIRES_IN=15m
SESSION_UNLOCK_EXPIRES_IN=5m

# Update to your frontend URL
FRONTEND_URL=https://your-frontend.pages.dev
FRONTEND_URLS=https://your-frontend.pages.dev
BASE_DOMAIN=yourdomain.com

# Redis (Render provides, or use default)
REDIS_URL=redis://localhost:6379

# Email service
RESEND_API_KEY=get_from_resend.com
FROM_EMAIL=noreply@yourdomain.com

# Optional: File storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# App config
APP_URL=https://api.yourdomain.com
APP_NAME=Bloom Care API
